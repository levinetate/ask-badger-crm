# Postgres connection string
DATABASE_URL="postgresql://user:password@host:5432/askbadger"
# Password for the owner admin screens
ADMIN_PASSWORD=""
# Long random string used to sign the admin login cookie
SESSION_SECRET=""
# Public URL of the app, used in email links
APP_URL="http://localhost:3000"
# Email via Resend. Leave blank in development: emails print to the console instead.
RESEND_API_KEY=""
EMAIL_FROM="Ask Badger Electric <bookings@example.com>"
# Protects the reminder job endpoint (Vercel Cron sends it as a Bearer token)
CRON_SECRET=""
# Optional: paid UPCitemdb key for barcode product lookups. Without it the free trial (about 100 a day) is used.
UPCITEMDB_KEY=""
