generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations. Vercel's Neon integration sets this for you.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// One row. Holds business details and booking rules.
model BusinessSettings {
  id               Int      @id @default(1)
  businessName     String   @default("Ask Badger Electric")
  ownerEmail       String   @default("")
  phone            String   @default("")
  timezone         String   @default("America/New_York")
  slotIntervalMin  Int      @default(30)
  bufferMin        Int      @default(30)
  minNoticeHours   Int      @default(12)
  maxDaysAhead     Int      @default(30)
  // Percent, e.g. 8.000 for 8%. Used by invoices later.
  taxRatePercent   Decimal  @default(8.0) @db.Decimal(6, 3)
  zelleInfo        String   @default("")
  // Default markup on materials, percent over your cost.
  defaultMarkupPercent Decimal @default(30) @db.Decimal(6, 2)
  // Default hourly labor rate for estimates and invoices, in cents. 0 = not set yet.
  laborRateCents   Int      @default(0)
  // Shown at the bottom of estimates and invoices.
  documentFooter   String   @default("")
  invoiceDueDays   Int      @default(7)
  // Email the owner the first time a customer opens an estimate or invoice.
  notifyOnOpen     Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

// Weekly working hours. weekday: 0 = Sunday ... 6 = Saturday.
// Minutes are counted from local midnight in the business timezone.
model AvailabilityRule {
  id          Int @id @default(autoincrement())
  weekday     Int
  startMinute Int
  endMinute   Int

  @@index([weekday])
}

model BlockedTime {
  id      Int      @id @default(autoincrement())
  startAt DateTime
  endAt   DateTime
  reason  String   @default("")

  @@index([startAt, endAt])
}

model ServiceType {
  id           Int           @id @default(autoincrement())
  name         String
  description  String        @default("")
  durationMin  Int
  // Optional starting price shown on the booking page, in cents.
  priceCents   Int?
  active       Boolean       @default(true)
  sortOrder    Int           @default(0)
  appointments Appointment[]
}

model Customer {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  phone        String        @default("")
  address      String        @default("")
  notes        String        @default("")
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  estimates    Estimate[]
  invoices     Invoice[]
}

enum AppointmentStatus {
  SCHEDULED // booked, waiting for the customer to confirm
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Appointment {
  id             Int               @id @default(autoincrement())
  customer       Customer          @relation(fields: [customerId], references: [id])
  customerId     Int
  serviceType    ServiceType       @relation(fields: [serviceTypeId], references: [id])
  serviceTypeId  Int
  startAt        DateTime
  endAt          DateTime
  status         AppointmentStatus @default(SCHEDULED)
  // Secret used in the customer's confirm / reschedule / cancel link.
  token          String            @unique
  jobAddress     String            @default("")
  customerNotes  String            @default("")
  internalNotes  String            @default("")
  bookedBy       String            @default("customer") // "customer" or "owner"
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  reminderSentAt DateTime?
  stockMovements StockMovement[]
  estimates      Estimate[]
  invoices       Invoice[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([startAt])
  @@index([status, startAt])
}

// A part or supply you buy and use on jobs.
model Material {
  id              Int             @id @default(autoincrement())
  name            String
  barcode         String?         @unique // UPC/EAN printed on the package
  sku             String          @default("") // store item number (Home Depot "Internet #"/SKU, Lowe's item #)
  store           String          @default("") // "Home Depot", "Lowe's", or other supplier
  category        String          @default("")
  unit            String          @default("each")
  costCents       Int             @default(0) // what you pay per unit
  // Null means use the business default markup.
  markupPercent   Decimal?        @db.Decimal(6, 2)
  quantityOnHand  Decimal         @default(0) @db.Decimal(12, 2)
  reorderAt       Decimal?        @db.Decimal(12, 2)
  location        String          @default("") // e.g. "Truck", "Shop"
  notes           String          @default("")
  active          Boolean         @default(true)
  costUpdatedAt   DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  movements       StockMovement[]
  lineItems       LineItem[]

  @@index([sku])
  @@index([name])
}

enum StockReason {
  PURCHASE // bought more
  USED // used on a job
  COUNT // set to a counted amount
  ADJUST // anything else (returned, damaged)
}

// Every change to stock, so counts can be explained later.
model StockMovement {
  id            Int          @id @default(autoincrement())
  material      Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId    Int
  change        Decimal      @db.Decimal(12, 2)
  reason        StockReason
  unitCostCents Int?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  appointmentId Int?
  note          String       @default("")
  createdAt     DateTime     @default(now())

  @@index([materialId, createdAt])
  @@index([appointmentId])
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
  INVOICED
}

model Estimate {
  id             Int            @id @default(autoincrement())
  customer       Customer       @relation(fields: [customerId], references: [id])
  customerId     Int
  appointment    Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  appointmentId  Int?
  status         EstimateStatus @default(DRAFT)
  token          String         @unique
  title          String         @default("")
  notes          String         @default("") // shown to the customer
  jobAddress     String         @default("")
  validUntil     DateTime?
  taxRatePercent Decimal        @db.Decimal(6, 3)
  subtotalCents  Int            @default(0)
  taxCents       Int            @default(0)
  totalCents     Int            @default(0)
  sentAt         DateTime?
  approvedAt     DateTime?
  approvedName   String         @default("") // name the customer typed to approve
  declinedAt     DateTime?
  declineReason  String         @default("")
  openedAt       DateTime?      // first time the email was opened (tracking pixel)
  viewedAt       DateTime?      // first time the customer opened the link
  lineItems      LineItem[]
  invoice        Invoice?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

model Invoice {
  id             Int           @id @default(autoincrement())
  customer       Customer      @relation(fields: [customerId], references: [id])
  customerId     Int
  estimate       Estimate?     @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  estimateId     Int?          @unique
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  appointmentId  Int?
  status         InvoiceStatus @default(DRAFT)
  token          String        @unique
  title          String        @default("")
  notes          String        @default("")
  jobAddress     String        @default("")
  dueDate        DateTime?
  taxRatePercent Decimal       @db.Decimal(6, 3)
  subtotalCents  Int           @default(0)
  taxCents       Int           @default(0)
  totalCents     Int           @default(0)
  amountPaidCents Int          @default(0) // completed payments only
  sentAt         DateTime?
  paidAt         DateTime?
  openedAt       DateTime?     // first time the email was opened (tracking pixel)
  viewedAt       DateTime?     // first time the customer opened the link
  lineItems      LineItem[]
  payments       Payment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
}

enum LineKind {
  LABOR
  MATERIAL
  OTHER
}

// A line on an estimate or an invoice (exactly one of the two is set).
model LineItem {
  id             Int       @id @default(autoincrement())
  estimate       Estimate? @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  estimateId     Int?
  invoice        Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      Int?
  kind           LineKind  @default(OTHER)
  description    String
  quantity       Decimal   @db.Decimal(12, 2)
  unitPriceCents Int
  taxable        Boolean   @default(false)
  material       Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  materialId     Int?
  sortOrder      Int       @default(0)

  @@index([estimateId])
  @@index([invoiceId])
}

enum PaymentMethod {
  SQUARE_CARD
  SQUARE_APPLE_PAY
  SQUARE_GOOGLE_PAY
  SQUARE_CASH_APP
  SQUARE_ACH
  ZELLE
  CASH
  CHECK
  OTHER
}

enum PaymentStatus {
  PENDING // e.g. a bank transfer that hasn't cleared
  COMPLETED
  FAILED
}

model Payment {
  id              Int           @id @default(autoincrement())
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId       Int
  method          PaymentMethod
  status          PaymentStatus
  amountCents     Int
  squarePaymentId String?       @unique
  receiptUrl      String        @default("")
  note            String        @default("")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([invoiceId])
}
